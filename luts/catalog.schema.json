{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qtekfun/UltimateCamera/luts/catalog.schema.json",
  "title": "UltimateCamera maker LUT catalogue (REQ-COL-006)",
  "description": "One entry per LUT file. Enforced at runtime by core-luts LutCatalogue.parse, which also applies the licence policy (REQ-COL-007/008): only redistributable entries may name a bundledPath, and link-only/unknown entries must not.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "luts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "luts": {
      "type": "array",
      "items": { "$ref": "#/$defs/lut" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "https": { "type": "string", "pattern": "^https://[^/\\s]+(/.*)?$" },
    "bytes": { "type": "integer", "minimum": 1, "maximum": 134217728 },
    "lut": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "maker", "name", "inputCurve", "output", "devices", "format", "size", "licence", "licenceNotes",
        "termsUrl", "pageUrl", "download", "checkedOn"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "Stable, unique id." },
        "maker": { "type": "string", "minLength": 1, "description": "Also the library folder the LUT is imported into." },
        "name": { "type": "string", "minLength": 1 },
        "inputCurve": { "type": "string", "minLength": 1, "description": "The Log curve the LUT expects, e.g. O-Log2." },
        "output": { "type": "string", "minLength": 1, "description": "What the LUT produces, e.g. Rec.709 Gamma 2.4 D65." },
        "devices": { "type": "array", "items": { "type": "string" }, "description": "Phones known to record inputCurve; informational." },
        "format": { "enum": ["cube", "3dl"] },
        "size": { "type": "integer", "minimum": 2, "maximum": 256, "description": "Lattice points per axis." },
        "licence": {
          "enum": ["redistributable", "link-only", "unknown"],
          "description": "redistributable: may be bundled with its notice. link-only and unknown: downloaded from the maker on request, never in the repo or APK."
        },
        "licenceNotes": { "type": "string", "minLength": 1, "description": "What the terms say and why the state was chosen." },
        "termsUrl": { "$ref": "#/$defs/https" },
        "pageUrl": { "$ref": "#/$defs/https", "description": "The official page that links the download." },
        "download": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "sha256", "bytes"],
          "properties": {
            "url": { "$ref": "#/$defs/https" },
            "sha256": { "$ref": "#/$defs/sha256", "description": "Of the file at url." },
            "bytes": { "$ref": "#/$defs/bytes" },
            "archiveEntry": { "type": "string", "description": "Path of the LUT inside a .zip download; no leading / and no .. segments." },
            "entrySha256": { "$ref": "#/$defs/sha256" },
            "entryBytes": { "$ref": "#/$defs/bytes" }
          },
          "dependentRequired": {
            "archiveEntry": ["entrySha256", "entryBytes"],
            "entrySha256": ["archiveEntry", "entryBytes"],
            "entryBytes": ["archiveEntry", "entrySha256"]
          }
        },
        "bundledPath": { "type": "string", "description": "Repository path of a bundled copy; only for redistributable entries." },
        "checkedOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "When url, checksums and terms were last verified." }
      },
      "if": { "properties": { "licence": { "const": "redistributable" } } },
      "then": { "required": ["bundledPath"] },
      "else": { "not": { "required": ["bundledPath"] } }
    }
  }
}
